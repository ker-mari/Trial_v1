APP_NAME="Lost & Found System"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://your-production-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/production/database.sqlite

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-production-domain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

# Mail Configuration (if needed)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# IMPORTANT SECURITY NOTES:
# 1. Generate a new APP_KEY using: php artisan key:generate
# 2. Change all default PINs in the database immediately
# 3. Use HTTPS in production (APP_URL should start with https://)
# 4. Set SESSION_ENCRYPT=true for production
# 5. Ensure database file has proper permissions (not world-readable)
# 6. Keep this file secure and never commit it to version control
# 7. Use strong, unique PINs for all users
# 8. Regularly backup your database
# 9. Monitor logs for suspicious activity
# 10. Consider implementing additional authentication layers

VITE_APP_NAME="${APP_NAME}"

